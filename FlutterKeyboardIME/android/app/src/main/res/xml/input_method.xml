<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.example.flutter_keyboard_ime.MainActivity"
    android:supportsSwitchingToNextInputMethod="true"
    android:isDefault="false">
    
    <!-- Subtype configurations for different input modes -->
    <subtype
        android:label="English"
        android:imeSubtypeLocale="en"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="TrySuppressingImeSwitcher,AsciiCapable,SupportTouchPositionCorrection"
        android:isAsciiCapable="true" />
        
    <subtype
        android:label="Indonesian"
        android:imeSubtypeLocale="id"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="TrySuppressingImeSwitcher,AsciiCapable,SupportTouchPositionCorrection"
        android:isAsciiCapable="true" />
</input-method>